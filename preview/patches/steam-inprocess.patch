+/* Own only children of the exact configured Steam browser image. A single
+ * non-inheritable job is kept until this browser exits. Steam and games are not
+ * members. Reuse atomic job-list assignment and nested-job support; do not
+ * enumerate or terminate processes by PID/name from the Mac host. */
+static BOOL pear_browser_child( const WCHAR *image, const WCHAR *command )
+{
+    WCHAR configured[MAX_PATH], current[MAX_PATH];
+    DWORD length;
+    const WCHAR *role;
+
+    length = GetEnvironmentVariableW( L"PEAR_STEAM_WEBHELPER_PATH", configured, ARRAY_SIZE(configured) );
+    if (!length || length >= ARRAY_SIZE(configured)) return FALSE;
+    length = GetModuleFileNameW( NULL, current, ARRAY_SIZE(current) );
+    if (!length || length >= ARRAY_SIZE(current)) return FALSE;
+    if (wcsicmp( current, configured ) || wcsicmp( image, configured )) return FALSE;
+    if (wcsstr( GetCommandLineW(), L"--type=" ) || !command) return FALSE;
+    if (!(role = wcsstr( command, L" --type=" ))) return FALSE;
+    role += 8;
+    return (!wcsncmp( role, L"renderer", 8 ) && (!role[8] || role[8] == ' ')) ||
+           (!wcsncmp( role, L"utility", 7 ) && (!role[7] || role[7] == ' '));
+}
+
+static BOOL WINAPI pear_browser_job_init( INIT_ONCE *once, void *parameter, void **context )
+{
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {0};
+    OBJECT_ATTRIBUTES attr;
+    HANDLE job;
+    NTSTATUS status;
+    InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+    if ((status = NtCreateJobObject( &job, JOB_OBJECT_ALL_ACCESS, &attr )))
+        return set_ntstatus( status );
+    limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    if ((status = NtSetInformationJobObject( job, JobObjectExtendedLimitInformation, &limits, sizeof(limits) )))
+    {
+        NtClose( job );
+        return set_ntstatus( status );
+    }
+    *context = job;
+    return TRUE;
+}
