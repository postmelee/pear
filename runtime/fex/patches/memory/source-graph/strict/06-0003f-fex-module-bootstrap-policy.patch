+    if (!TID || Threads.contains(TID)) return;
+    DWORD* Empty {};
+    for (auto& Pending : PearPendingTIDs) {
+      if (Pending == TID) return;
+      if (!Pending && !Empty) Empty = &Pending;
+    }
+    if (!Empty) { Failure = STATUS_NO_MEMORY; return; }
+    *Empty = TID; Owned = true;
+  }
+  ~PearThreadPreparation() {
