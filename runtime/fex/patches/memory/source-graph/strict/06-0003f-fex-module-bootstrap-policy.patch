+    for (auto& Pending : PearPendingTIDs) if (Pending == TID) { Pending = 0; break; }
+  }
+  void Commit() { Committed = true; }
+  explicit operator bool() const { return Owned; }
+  DWORD ID() const { return TID; }
+  NTSTATUS Status() const { return Failure; }
