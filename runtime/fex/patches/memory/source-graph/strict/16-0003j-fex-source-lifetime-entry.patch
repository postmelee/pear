+PearContextOwner FEXCore::Context::Context::CreatePearContext(const FEXCore::HostFeatures& Features,
+    FEXCore::Utils::PearFEXMemory::Result& Outcome) {
+  auto Actual=fextl::make_unique<FEXCore::Context::ContextImpl>(Features);
+  Outcome=Actual->GetPearLifetimeCreation();
+  if (!Outcome) {
+    // This actual allocation was never admitted, bound or initialized. Its
+    // upstream NX fields can be destroyed by the still-owned original deleter.
+    FEXCore::Utils::PearFEXMemory::Retirement::PoisonSourceAdmission(Outcome); return {};
+  }
+  return PearContextOwner {Actual.release()};
+}
+void PearContextDeleter::operator()(Context* Actual) const {
+  if (!Actual) return;
+  namespace Memory=FEXCore::Utils::PearFEXMemory;
+  Memory::Result Outcome;
+  if (!Actual->PreparePearConstructionCleanup(Outcome)) {
+    // Keep this actual allocation alive in its fixed Context identity record.
+    // A refusal from a destructor body cannot prevent member destruction.
+    Memory::SourceLifecycle::Retain(Actual,Outcome); return;
+  }
+  const auto Started=Memory::SourceLifecycle::BeginContextDestruction(Actual);
+  if (!Started) { Memory::SourceLifecycle::Retain(Actual,Started); return; }
+  std::destroy_at(Actual);
+  // Erase the exact source tombstone before allocator reuse of this address.
+  const auto Deleted=Memory::SourceLifecycle::Deleted(Actual);
+  if (!Deleted) { Memory::SourceLifecycle::RetainDestroyed(Actual,Deleted); return; }
+  FEXCore::Allocator::aligned_free(Actual);
+}
