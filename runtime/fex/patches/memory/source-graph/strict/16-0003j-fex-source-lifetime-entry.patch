+  if (Status == STATUS_TIMEOUT) return {PEAR_FEX_QUIESCENCE_TIMEOUT,PEAR_FEX_ERROR_NTSTATUS,static_cast<int32_t>(Status)};
+  return {PEAR_FEX_NATIVE_FAILURE,PEAR_FEX_ERROR_NTSTATUS,static_cast<int32_t>(Status)};
