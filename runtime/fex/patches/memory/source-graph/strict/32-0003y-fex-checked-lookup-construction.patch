+DLLEXPORT_FUNC(void*, VirtualAlloc, (void* lpAddress, SIZE_T dwSize, DWORD flAllocationType, DWORD flProtect)) {
+  const auto Status=AllocateVirtualChecked(lpAddress,dwSize,flAllocationType,flProtect);
