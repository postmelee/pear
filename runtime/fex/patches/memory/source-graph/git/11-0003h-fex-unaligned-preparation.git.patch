+[[nodiscard]]
+std::optional<int32_t> HandleUnalignedAccess(FEXCore::Core::InternalThreadState* Thread,
+  UnalignedHandlerType HandleType, uintptr_t ProgramCounter, uint64_t* GPRs, bool IsJIT) {
+#ifdef PEAR_FEX_MEMORY_OWNER
+  // No raw asynchronous call may acquire owner locks, wait or read code before
+  // the actual ACTIVE source binding and per-page observations are available.
+  (void)Thread; (void)HandleType; (void)ProgramCounter; (void)GPRs; (void)IsJIT;
+  return std::nullopt;
+#else
+#if !defined(ARCHITECTURE_arm64)
+  return std::nullopt;
+#endif
+  auto CTX = static_cast<Context::ContextImpl*>(Thread->CTX);
+  auto* Strict = CTX->Config.StrictInProcessSplitLocks ? &CTX->StrictSplitLockMutex : nullptr;
+  CPU::CPUBackend::JITCodeTail* Tail {};
+  if (IsJIT) {
+    const auto Begin = Thread->CurrentFrame->State.InlineJITBlockHeader;
+    const auto* Header = reinterpret_cast<const CPU::CPUBackend::JITCodeHeader*>(Begin);
+    Tail = reinterpret_cast<CPU::CPUBackend::JITCodeTail*>(Begin + Header->OffsetToBlockTail);
+  }
+  return HandleUnalignedAccessImpl(HandleType, ProgramCounter, GPRs, IsJIT, Strict, Thread->ExclusiveStore, Tail);
+#endif
+}
