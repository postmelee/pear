+#ifdef PEAR_FEX_MEMORY_OWNER
+PreparedUnalignedPatch PrepareUnalignedPatchSnapshot(UnalignedHandlerType HandleType,
+  std::span<const uint32_t, 13> Snapshot) {
+  return UnalignedPreparation::PrepareSnapshot(HandleType, Snapshot);
+}
+
+#endif
+
