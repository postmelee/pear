From: Pear contributors
Subject: [PATCH] ntdll: preserve Darwin x18 modes at actual Wine boundaries

Original Pear integration against Wine 4e819f054dd2d9ee855ee3f1e30d8c1bb8f80fcf.
Reuse Wine's syscall frames, callback ownership, signal handlers and thread entry.
Resolve Apple mode APIs before PE entry, and keep all ordinary C/POSIX execution
in host mode. The finite signal gateway is a prerequisite, not complete signal
or exception qualification. Existing Wine LGPL-2.1-or-later notices apply.

--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -27,6 +27,9 @@
 #include "config.h"
 
 #include <assert.h>
+#ifdef __APPLE__
+# include <dlfcn.h>
+#endif
 #include <pthread.h>
 #include <signal.h>
 #include <stdlib.h>
@@ -63,6 +66,22 @@
 
 #define NTDLL_DWARF_H_NO_UNWINDER
 #include "dwarf.h"
+
+#ifdef __APPLE__
+/* Original Pear Darwin ABI integration. The mode APIs are resolved before any
+ * PE entry. Only these pre-resolved APIs may be called with foreign x18 active.
+ * A mode mismatch traps in assembly instead of calling a host error routine. */
+unsigned char (*pear_x18_getter)(void);
+void (*pear_x18_setter)(unsigned char);
+
+#define PEAR_ENTER_HOST "bl " __ASM_NAME("pear_x18_enter_host") "\n\t"
+#define PEAR_ENTER_GUEST "bl " __ASM_NAME("pear_x18_enter_guest") "\n\t"
+#define PEAR_SIGNAL_HANDLER __attribute__((used))
+#else
+#define PEAR_ENTER_HOST ""
+#define PEAR_ENTER_GUEST ""
+#define PEAR_SIGNAL_HANDLER
+#endif
 
 struct arm64_thread_data
 {
@@ -872,6 +891,198 @@
 }
 
 
+#ifdef __APPLE__
+/* 0x2c0-byte spill area is below the live Wine syscall frame. Preserve
