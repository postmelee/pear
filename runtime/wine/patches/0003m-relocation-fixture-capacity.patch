From: Pear contributors
Subject: [PATCH] wine: reserve finite capacity for two original relocation copies

Original Pear native owner budget adjustment. Preserve the complete installed
ARM64 inventory and largest-image preparation margin while accounting for two
simultaneously loaded copies of the original lifetime/relocation fixture.
The build independently derives their rounded SizeOfImage from actual PE bytes.
The budget includes the observed extra 64 KiB shell32 debug-section alignment
from the longer attempt10 build path; future excess remains a hard failure.
This does not change page-W^X, owner generations, preparation or retirement.
The original Pear header retains its MIT notice; Wine integration retains its
existing LGPL-2.1-or-later notices. No arbitrary-game capacity is implied.

--- a/dlls/ntdll/unix/pear_pe_arena.h
+++ b/dlls/ntdll/unix/pear_pe_arena.h
@@ -3,11 +3,13 @@
 #ifndef __PEAR_PE_ARENA_H
 #define __PEAR_PE_ARENA_H
 
-#define PEAR_ARENA_INTERIOR_BYTES ((SIZE_T)1049952256)
+#define PEAR_ARENA_INTERIOR_BYTES ((SIZE_T)1050148864)
 #define PEAR_ARENA_ALIGNMENT ((SIZE_T)65536)
 #define PEAR_ARENA_MAPPING_BYTES (PEAR_ARENA_INTERIOR_BYTES + PEAR_ARENA_ALIGNMENT)
 #define PEAR_ARENA_MAX_IMAGE_BYTES ((SIZE_T)38993920)
-#define PEAR_ARENA_MAX_SLOTS 752u
+#define PEAR_ARENA_MAX_SLOTS 754u
+/* Two simultaneously owned copies of the original relocation fixture. */
+#define PEAR_ARENA_RELOCATION_COPIES 2u
 #define PEAR_ARENA_PAGE_BYTES ((SIZE_T)4096)
 
 struct pear_pe_plan;
